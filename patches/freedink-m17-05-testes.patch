Spec 047 (plano D-02, D-12; so testes): com -DM17, M17_JANELA (janela 480x272 no driver dummy) e o roteiro
M17_ROTEIRO (teclas, botoes e eixos do joystick simulados, capturas, FIM), como o do spike; sem as variaveis,
nada muda.

diff -ru a/src/app.cpp b/src/app.cpp
--- a/src/app.cpp	2026-10-23 16:23:48.465319456 -0300
+++ b/src/app.cpp	2026-10-23 16:24:57.926975482 -0300
@@ -450,7 +450,113 @@
 #endif
 }
 
+#ifdef M17
+/* M17 (spec 047, so testes): roteiro M17_ROTEIRO, uma acao por linha, "quadro acao", lido a cada iteracao:
+     <Tecla>       toque (desce agora, sobe na iteracao seguinte); nome do SDL, "_" = espaco ("Left_Ctrl")
+     +<Tecla>      segura      -<Tecla>  solta
+     @<arquivo>    captura da janela em BMP (SDL_RenderReadPixels)
+     B<n>          toque no botao fisico n do joystick (+B<n> segura, -B<n> solta; o qemu nao tem joystick: o
+                   primeiro B/E liga a simulacao, patch 03)
+     E<a>=<v>      o eixo a do joystick passa a valer v (-32768..32767)
+     FIM           SDL_QUIT
+   O log diz cada passo ("[M17] tecla ...", "[M17] tela ...", "[M17] roteiro: fim"): os testes esperam por ele. */
+static void m17_roteiro(void) {
+	static FILE* f = NULL;
+	static int lido = 0, quadro = 0, q = 0, solta = -1;
+	static char arg[256];
+	if (!lido) {
+		lido = 1;
+		const char* r = getenv("M17_ROTEIRO");
+		if (r != NULL && *r)
+			f = fopen(r, "r");
+		if (f != NULL && fscanf(f, "%d %255s", &q, arg) != 2) {
+			fclose(f);
+			f = NULL;
+		}
+	}
+	quadro++;
+	static int solta_b = -1;
+	if (solta_b >= 0) {
+		m17_teste_botoes &= ~(1u << solta_b);
+		solta_b = -1;
+	}
+	if (solta >= 0) {
+		SDL_Event e;
+		memset(&e, 0, sizeof(e));
+		e.type = SDL_KEYUP;
+		e.key.state = SDL_RELEASED;
+		e.key.keysym.scancode = (SDL_Scancode)solta;
+		e.key.keysym.sym = SDL_GetKeyFromScancode((SDL_Scancode)solta);
+		SDL_PushEvent(&e);
+		solta = -1;
+	}
+	while (f != NULL && quadro >= q) {
+		if (arg[0] == '@') {
+			SDL_Renderer* r = SDL_GetRenderer(SDL_GetWindowFromID(1));
+			int w, h;
+			SDL_GetRendererOutputSize(r, &w, &h);
+			SDL_Surface* s = SDL_CreateRGBSurfaceWithFormat(0, w, h, 32, SDL_PIXELFORMAT_ARGB8888);
+			SDL_RenderReadPixels(r, NULL, SDL_PIXELFORMAT_ARGB8888, s->pixels, s->pitch);
+			SDL_SaveBMP(s, arg + 1);
+			SDL_FreeSurface(s);
+			fprintf(stderr, "[M17] tela %s (%dx%d) quadro %d\n", arg + 1, w, h, quadro);
+		} else if ((arg[0] == 'B' || ((arg[0] == '+' || arg[0] == '-') && arg[1] == 'B'))
+			   && arg[(arg[0] == 'B') ? 1 : 2] >= '0' && arg[(arg[0] == 'B') ? 1 : 2] <= '9') {
+			int modo = (arg[0] == '+') ? 1 : (arg[0] == '-') ? 2 : 0;
+			int n = atoi(arg + (modo ? 2 : 1));
+			m17_teste_ligado = 1;
+			if (n >= 0 && n < 32) {
+				if (modo == 2)
+					m17_teste_botoes &= ~(1u << n);
+				else
+					m17_teste_botoes |= 1u << n;
+				if (modo == 0)
+					solta_b = n;
+			}
+			fprintf(stderr, "[M17] botao %s quadro %d\n", arg, quadro);
+		} else if (arg[0] == 'E' && arg[1] >= '0' && arg[1] <= '3' && arg[2] == '=') {
+			m17_teste_ligado = 1;
+			m17_teste_eixos[arg[1] - '0'] = atoi(arg + 3);
+			fprintf(stderr, "[M17] eixo %s quadro %d\n", arg, quadro);
+		} else if (strcmp(arg, "FIM") == 0) {
+			SDL_Event e;
+			memset(&e, 0, sizeof(e));
+			e.type = SDL_QUIT;
+			SDL_PushEvent(&e);
+			fprintf(stderr, "[M17] roteiro: fim\n");
+		} else {
+			for (char* c = arg; *c; c++)
+				if (*c == '_')
+					*c = ' ';
+			int modo = (arg[0] == '+') ? 1 : (arg[0] == '-') ? 2 : 0;
+			SDL_Scancode sc = SDL_GetScancodeFromName(arg + (modo ? 1 : 0));
+			if (sc == SDL_SCANCODE_UNKNOWN) {
+				fprintf(stderr, "[M17] roteiro: tecla desconhecida %s\n", arg);
+			} else {
+				SDL_Event e;
+				memset(&e, 0, sizeof(e));
+				e.type = (modo == 2) ? SDL_KEYUP : SDL_KEYDOWN;
+				e.key.state = (modo == 2) ? SDL_RELEASED : SDL_PRESSED;
+				e.key.keysym.scancode = sc;
+				e.key.keysym.sym = SDL_GetKeyFromScancode(sc);
+				SDL_PushEvent(&e);
+				if (modo == 0)
+					solta = sc;
+				fprintf(stderr, "[M17] tecla %s quadro %d\n", arg, quadro);
+			}
+		}
+		if (fscanf(f, "%d %255s", &q, arg) != 2) {
+			fclose(f);
+			f = NULL;
+		}
+	}
+}
+#endif
+
 void App::one_iter() {
+#ifdef M17
+		m17_roteiro();
+#endif
 		/* Controller: dispatch events */
 		SDL_Event event;
 		SDL_Event* ev = &event;
