diff --git a/src/input.cpp b/src/input.cpp
index 4b8b116..c0a59b1 100644
--- a/src/input.cpp
+++ b/src/input.cpp
@@ -82,6 +82,26 @@ bool input_init(void)
   mappings[ESCKEY].jbut       = 11; // -
 #endif
 
+#if defined(M17)
+  // M17 (spec 030, plano D-04): o i2c-keys chega ao SDL2 como joystick; indices medidos (KB §11k).
+  // Faces pelo rotulo impresso, como no port do Switch: pular embaixo, atirar a direita.
+  // SELECT (12) fica de fora: SELECT+START e a saida do m17atalhos.
+  mappings[UPKEY].jbut        = 13;
+  mappings[DOWNKEY].jbut      = 16;
+  mappings[LEFTKEY].jbut      = 14;
+  mappings[RIGHTKEY].jbut     = 15;
+  mappings[JUMPKEY].jbut      = 6;  // A
+  mappings[FIREKEY].jbut      = 11; // B
+  mappings[INVENTORYKEY].jbut = 9;  // X
+  mappings[ESCKEY].jbut       = 5;  // START: pausa
+  // Y, L1 e R1 nao foram medidos (KB §11k): inferidos da ordem dos keycodes no SDL (L3/R3 = 0/1,
+  // depois os keycodes crescentes: R1 19, Y 21, START 28 = 5...). Cada botao vai para o log (abaixo)
+  // e a sessao no aparelho confere (spec 030, T14).
+  mappings[MAPSYSTEMKEY].jbut = 4;  // Y
+  mappings[PREVWPNKEY].jbut   = 7;  // L1
+  mappings[NEXTWPNKEY].jbut   = 3;  // R1
+#endif
+
   mappings[F1KEY].key  = SDLK_F1;
   mappings[F2KEY].key  = SDLK_F2;
   mappings[F3KEY].key  = SDLK_F3;
@@ -340,6 +360,9 @@ void input_poll(void)
       case SDL_JOYBUTTONDOWN:
       {
         Uint8 but            = evt.jbutton.button;
+#if defined(M17)
+        LOG_INFO("[M17] botao {}", (int)but); // a sessao confere os indices (spec 030)
+#endif
         last_sdl_action.jbut = but;
         ino                  = input_get_action_but(but); // mappings[key];
         if (ino != -1)
