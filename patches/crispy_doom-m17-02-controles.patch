diff --git a/src/i_joystick.c b/src/i_joystick.c
index eb903de..258395f 100644
--- a/src/i_joystick.c
+++ b/src/i_joystick.c
@@ -28,6 +28,9 @@
 #include "d_event.h"
 #include "i_joystick.h"
 #include "i_system.h"
+#if defined(M17)
+#include "m_controls.h"   // M17 (spec 033): as acoes ligadas a botoes (joyb_*)
+#endif
 
 #include "m_config.h"
 #include "m_fixed.h"
@@ -763,6 +766,44 @@ static int GetDirectionalInput(int x, int y)
     return (retval << DPAD_SHIFT);
 }
 
+#if defined(M17)
+// M17 (spec 033, D-03): botao do D-pad livre = nenhum joyb_* ligado a ele (a configuracao do produto deixa os
+// botoes virtuais iguais aos fisicos, joystick_physical_buttonN = N)
+static boolean M17_BotaoLivre(int b)
+{
+    const int *acoes[] = {
+        &joybfire, &joybstrafe, &joybuse, &joybspeed, &joybjump, &joybstrafeleft, &joybstraferight,
+        &joybprevweapon, &joybnextweapon, &joybmenu, &joybautomap, &joybuseartifact, &joybinvleft,
+        &joybinvright, &joybflyup, &joybflydown, &joybflycenter,
+    };
+    size_t i;
+
+    for (i = 0; i < sizeof(acoes) / sizeof(acoes[0]); ++i)
+    {
+        if (*acoes[i] == b)
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int M17_EixoDpad(int neg, int pos)
+{
+    int result = 0;
+
+    if (M17_BotaoLivre(neg) && SDL_JoystickGetButton(joystick, neg))
+    {
+        result -= 32767;
+    }
+    if (M17_BotaoLivre(pos) && SDL_JoystickGetButton(joystick, pos))
+    {
+        result += 32767;
+    }
+    return result;
+}
+#endif
+
 void I_UpdateJoystick(void)
 {
     if (use_gamepad)
@@ -785,6 +826,19 @@ void I_UpdateJoystick(void)
                                 joystick_strafe_dead_zone);
         ev.data5 = GetAxisState(joystick_look_axis, joystick_look_invert,
                                 joystick_look_dead_zone);
+#if defined(M17)
+        // M17 (spec 031, T12): o Crispy le uma fonte por eixo; com os analogicos nos eixos (key_mode 6),
+        // o D-pad do aparelho (botoes 13-16, KB 11k) vale quando o analogico esta parado: gira e anda.
+        // Spec 033 (D-03): so os botoes do D-pad sem acao (Heretic: inventario e voo; Strife: inventario)
+        if (ev.data2 == 0)
+        {
+            ev.data2 = M17_EixoDpad(14, 15);
+        }
+        if (ev.data3 == 0)
+        {
+            ev.data3 = M17_EixoDpad(13, 16);
+        }
+#endif
         ev.data6 = GetDirectionalInput(ev.data2, ev.data3);
         D_PostEvent(&ev);
     }
