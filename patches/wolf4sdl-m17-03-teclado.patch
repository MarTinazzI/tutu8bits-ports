--- a/id_us.c
+++ b/id_us.c
@@ -481,10 +481,32 @@ char USL_RotateChar(char ch, int dir)
 //		returned
 //
 ///////////////////////////////////////////////////////////////////////////
+#ifdef M17
+#include "teclado.h"
+// M17 (spec 037, D-06): o texto (nome do save e do placar) pelo teclado virtual da spec 036; quem chama poe o titulo
+const char *m17_titulo;
+extern SDL_Renderer *renderer;
+#endif
 boolean
 US_LineInput(int x,int y,char *buf,const char *def,boolean escok,
 				int maxchars,int maxwidth)
 {
+#ifdef M17
+	{
+		char b[256];
+		int ok;
+		snprintf (b, sizeof(b), "%s", def ? def : buf);
+		if (maxchars > (int) sizeof(b) - 1)
+			maxchars = sizeof(b) - 1;
+		ok = m17_teclado (renderer, m17_titulo ? m17_titulo : "Texto", b, maxchars);
+		m17_titulo = NULL;
+		if (ok)
+			snprintf (buf, maxchars + 1, "%s", b);
+		IN_ClearKeysDown ();
+		(void) x; (void) y; (void) escok; (void) maxwidth;
+		return ok ? true : false;
+	}
+#endif
 	boolean		redraw,
 				cursorvis,cursormoved,
 				done,result, checkkey;
