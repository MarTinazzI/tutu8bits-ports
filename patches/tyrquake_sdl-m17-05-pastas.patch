diff --git a/common/m17_saida.c b/common/m17_saida.c
new file mode 100644
index 0000000..58c443c
--- /dev/null
+++ b/common/m17_saida.c
@@ -0,0 +1,43 @@
+/*
+ * m17_saida.c — quadros e saida no log do jogo (spec 050, plano D-08).
+ *
+ * Ao sair pelo Sys_Quit (SDL_QUIT, que e o SIGTERM do VOL+), antes de gravar a configuracao: a linha de quadros no
+ * formato do patch do RetroArch (o diagnostico do lancar.sh a le: "[M17] quadros=N desenhados=N segundos=S
+ * fps_medio=F fps_desenhado=F"); depois de gravar, "[M17] saida" (o fim normal do lancar.sh).
+ */
+#include <stdio.h>
+
+#include "host.h"
+#include "quakedef.h"
+#include "sys.h"
+
+#include "m17.h"
+
+static unsigned long long desenhados;
+static double inicio = -1;
+
+void
+M17_QuadroDesenhado(void)
+{
+    if (inicio < 0)
+        inicio = Sys_DoubleTime();
+    desenhados++;
+}
+
+void
+M17_Quadros(void)
+{
+    double s = inicio < 0 ? 0 : Sys_DoubleTime() - inicio;
+
+    fprintf(stderr, "[M17] quadros=%llu desenhados=%llu segundos=%.1f fps_medio=%.2f fps_desenhado=%.2f\n",
+            (unsigned long long)host_framecount, desenhados, s, s > 0 ? host_framecount / s : 0.0,
+            s > 0 ? desenhados / s : 0.0);
+    fflush(stderr);
+}
+
+void
+M17_Saida(void)
+{
+    fprintf(stderr, "[M17] saida\n");
+    fflush(stderr);
+}
diff --git a/common/sys_unix.c b/common/sys_unix.c
index 35cd9dc..021e4ea 100644
--- a/common/sys_unix.c
+++ b/common/sys_unix.c
@@ -39,6 +39,9 @@ Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
 #include "buildinfo.h"
 #include "common.h"
 #include "sys.h"
+#ifdef M17
+#include "m17.h"
+#endif
 #include "zone.h"
 
 #ifdef SERVERONLY
@@ -72,6 +75,15 @@ Sys_UserDataDirectory()
 {
     static char unix_userdir[MAX_OSPATH];
     const char *home = getenv("HOME");
+#ifdef M17
+    /* spec 050 (plano D-05): a pasta do usuario e a do lancador (saves/jogos/quake/<jogo>), sem o .tyrquake: o motor
+     * grava saves e config em <pasta>/<pasta do jogo>/, onde o nucleo libretro gravava */
+    const char *m17 = getenv("M17_USERDIR");
+    if (m17 && *m17) {
+        qsnprintf(unix_userdir, sizeof(unix_userdir), "%s", m17);
+        return unix_userdir;
+    }
+#endif
     if (home) {
         qsnprintf(unix_userdir, sizeof(unix_userdir), "%s/.tyrquake", home);
         return unix_userdir;
@@ -123,7 +135,13 @@ void
 Sys_Quit(void)
 {
 #ifndef SERVERONLY
+#ifdef M17
+    M17_Quadros();
+#endif
     Host_Shutdown();
+#ifdef M17
+    M17_Saida();
+#endif
     fcntl(STDIN_FILENO, F_SETFL,
 	  fcntl(STDIN_FILENO, F_GETFL, 0) & ~O_NONBLOCK);
     fflush(stdout);
