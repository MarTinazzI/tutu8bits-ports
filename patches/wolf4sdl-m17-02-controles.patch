 void PollJoystickMove (void)
 {
+#ifdef M17
+    // M17 (spec 037, D-04; como o Doom, spec 031): analogico esquerdo anda (eixo 1) e vai de lado (eixo 0), direito
+    // gira (eixo 2; key_mode 6, KB 11z); o D-pad anda (cima/baixo) e gira (esquerda/direita). Proporcional.
+    extern SDL_Joystick *M17_Joystick (void);
