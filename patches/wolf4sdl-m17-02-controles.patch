+    if (SDL_JoystickGetButton (j, 15)) rx = 127;
+    if (ly > zona || ly < -zona)
+        controly += ly * delta / 127;
+    if (rx > zona || rx < -zona)
+        controlx += rx * delta / 127;
+    if (lx > 64)
