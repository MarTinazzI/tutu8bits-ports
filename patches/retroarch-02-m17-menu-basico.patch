+/* M17 (spec 025, D-06): remap por jogo sem passo extra. Ao descarregar o jogo, se a tela
+ * Controls foi aberta, se nao ha remap ativo (com remap de jogo, o remap_save_on_exit ja o
+ * regrava; com o de nucleo ou de pasta, fica o comportamento do RetroArch) e se os
+ * mapeamentos de botoes, analogicos ou portas diferem do padrao, grava o remap do jogo:
+ * a mesma operacao do "Save Game Remap File" (<remaps>/<nucleo>/<rom>.rmp). */
+void m17_remap_ao_sair(void)
+{
+   unsigned i, j;
+   bool difere          = false;
+   settings_t *settings = config_get_ptr();
+   uint32_t flags       = runloop_get_flags();
+
+   if (!m17_controles_abertos)
+      return;
+   m17_controles_abertos = false;
+
+   if (flags & (RUNLOOP_FLAG_REMAPS_CORE_ACTIVE
+              | RUNLOOP_FLAG_REMAPS_CONTENT_DIR_ACTIVE
+              | RUNLOOP_FLAG_REMAPS_GAME_ACTIVE))
+   {
+      RARCH_LOG("[M17] remap: nada a gravar (ja ha remap ativo)\n");
+      return;
+   }
+
+   for (i = 0; i < MAX_USERS && !difere; i++)
+   {
+      for (j = 0; j < RARCH_FIRST_CUSTOM_BIND; j++)
+         if (     settings->uints.input_remap_ids[i][j]     != input_config_binds[i][j].id
+               || settings->uints.input_keymapper_ids[i][j] != RETROK_UNKNOWN)
+            difere = true;
+      for (j = RARCH_FIRST_CUSTOM_BIND; j < RARCH_FIRST_CUSTOM_BIND + 8; j++)
+         if (settings->uints.input_remap_ids[i][j] != j)
+            difere = true;
+      if (settings->uints.input_remap_ports[i] != i)
+         difere = true;
+   }
+
+   if (!difere)
+   {
+      RARCH_LOG("[M17] remap: nada a gravar (igual ao padrao)\n");
+      return;
+   }
+
+   /* a operacao devolve 0 mesmo se a gravacao falhar; so liga o "remap de jogo ativo" se gravou */
+   generic_action_ok_remap_file_operation(NULL, NULL, 0, 0, 0,
+         ACTION_OK_REMAP_FILE_SAVE_GAME);
+   if (runloop_get_flags() & RUNLOOP_FLAG_REMAPS_GAME_ACTIVE)
+      RARCH_LOG("[M17] remap: gravado o do jogo (%s)\n", path_get(RARCH_PATH_BASENAME));
+   else
+      RARCH_ERR("[M17] remap: falhou ao gravar o do jogo\n");
+}
+
