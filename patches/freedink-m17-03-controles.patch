--- a/src/input.cpp	2026-10-23 16:14:08.163469014 -0300
+++ b/src/input.cpp	2026-10-23 19:30:36.596430898 -0300
@@ -54,6 +54,66 @@
 SDL_Joystick* jinfo;
 int joystick = /*true*/1;
 
+#ifdef M17
+/* indice fisico do SDL (KB 11k, 11zg) -> botao do Dink (1-10, o mapa padrao: 1 atacar, 2 falar, 3 magia, 4 inventario,
+   5 menu, 6 mapa, 7-10 os botoes extras dos D-Mods); negativo = uma seta (-acao). Tabela da spec 047, secao 8 */
+static const int m17_dink[17] = {
+  0,              /* 0  -                                                */
+  0,              /* 1  L3: livre                                        */
+  0,              /* 2  R3: a roda (patch 04)                            */
+  8,              /* 3  R1                                               */
+  4,              /* 4  Y: inventario                                    */
+  5,              /* 5  START: menu                                      */
+  1,              /* 6  A: atacar / clicar                               */
+  7,              /* 7  L1                                               */
+  9,              /* 8  L2                                               */
+  3,              /* 9  X: magia                                         */
+  10,             /* 10 R2                                               */
+  2,              /* 11 B: falar                                         */
+  6,              /* 12 SELECT: mapa                                     */
+  -ACTION_UP,     /* 13 D-pad cima                                       */
+  -ACTION_LEFT,   /* 14 D-pad esquerda                                   */
+  -ACTION_RIGHT,  /* 15 D-pad direita                                    */
+  -ACTION_DOWN,   /* 16 D-pad baixo                                      */
+};
+int m17_teste_ligado = 0;
+unsigned m17_teste_botoes = 0;
+int m17_teste_eixos[4] = { 0, 0, 0, 0 };
+
+int m17_botao(int i) {
+  if (m17_teste_ligado)
+    return i >= 0 && i < 32 && (m17_teste_botoes & (1u << i)) != 0;
+  return joystick && jinfo != NULL && SDL_JoystickGetButton(jinfo, i);
+}
+
+int m17_eixo(int a) {
+  if (m17_teste_ligado)
+    return (a >= 0 && a < 4) ? m17_teste_eixos[a] : 0;
+  return (joystick && jinfo != NULL && a < SDL_JoystickNumAxes(jinfo)) ? SDL_JoystickGetAxis(jinfo, a) : 0;
+}
+
+void m17_ler_controle(void) {
+  if (!joystick && !m17_teste_ligado)
+    return;
+  if (joystick && jinfo != NULL)
+    SDL_JoystickUpdate();
+  for (int i = 0; i < 17; i++) {
+    if (!m17_botao(i))
+      continue;
+    if (m17_dink[i] > 0)
+      sjoy.joybit[input_get_button_action(m17_dink[i] - 1)] = 1;
+    else if (m17_dink[i] < 0)
+      sjoy.joybit[-m17_dink[i]] = 1;
+  }
+  /* o analogico esquerdo anda, como no motor original (30 % do curso) */
+  int threshold = 32767 * 30 / 100, x = m17_eixo(0), y = m17_eixo(1);
+  if (x < -threshold) sjoy.left  = 1;
+  if (x > +threshold) sjoy.right = 1;
+  if (y < -threshold) sjoy.up    = 1;
+  if (y > +threshold) sjoy.down  = 1;
+}
+#endif
+
 
