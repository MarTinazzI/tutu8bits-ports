+#ifdef M17
+/* M17 (spec 047, plano D-04): nos menus de cursor (o titulo e as telas de escolha, scripts de cada D-Mod), cada toque
+   no direcional leva o cursor ao centro do botao clicavel (touch_damage -1 com script, os mesmos que o clique procura)
+   mais proximo naquela direcao, em vez do andar continuo. Um D-Mod pode deixar um botao escondido mas ativo (o
+   Pilgrim's Quest deixa o "Begin" atras da tela de escolha), e o salto o acha tambem (spike). */
+static void m17_salto(int h)
+{
+	int ux = sjoy.rightd ? 1 : sjoy.leftd ? -1 : 0;
+	int uy = sjoy.downd ? 1 : sjoy.upd ? -1 : 0;
+	if (ux == 0 && uy == 0)
+		return;
+	if (ux != 0)
+		uy = 0;
+	int melhor = -1, mx = 0, my = 0;
+	for (int i = 1; i <= last_sprite_created; i++) {
+		if (!spr[i].active || i == h || spr[i].touch_damage != -1 || spr[i].script == 0)
+			continue;
+		rect box;
+		rect_copy(&box, &k[getpic(i)].hardbox);
+		rect_offset(&box, spr[i].x, spr[i].y);
+		int cx = (box.left + box.right) / 2, cy = (box.top + box.bottom) / 2;
+		int dx = cx - spr[h].x, dy = cy - spr[h].y;
+		int proj = dx * ux + dy * uy;
+		if (proj <= 4)
+			continue;
+		int perp = abs(dx * uy - dy * ux);
+		int nota = proj + 2 * perp;
+		if (melhor < 0 || nota < melhor) {
+			melhor = nota;
+			mx = cx;
+			my = cy;
+		}
+	}
+	if (melhor >= 0) {
+		spr[h].x = mx;
+		spr[h].y = my;
+		log_info("[M17] salto para %d,%d", mx, my);
+	}
+}
+
+/* M17 (spec 047, plano D-04): o analogico direito (eixos 2 e 3 do SDL, KB 11zg) move o cursor livre e proporcional:
+   zona morta de 25 % do curso, ate M17_CURSOR_MAX pixels por quadro (na resolucao do jogo, 640x480) com o analogico
+   na borda, com as fracoes acumuladas (anda devagar perto da zona morta). Quando para, o log diz onde ficou. */
+#define M17_CURSOR_ZONA 8192
+#define M17_CURSOR_MAX 6.0f
+static float m17_veloc(int v)
+{
+	int a = v < 0 ? -v : v;
+	if (a <= M17_CURSOR_ZONA)
+		return 0.0f;
+	float f = (float)(a - M17_CURSOR_ZONA) / (float)(32767 - M17_CURSOR_ZONA);
+	if (f > 1.0f)
+		f = 1.0f;
+	return (v < 0 ? -f : f) * M17_CURSOR_MAX;
+}
+
+static void m17_cursor(int h)
+{
+	static float fx = 0.0f, fy = 0.0f;
+	static int andando = 0;
+	float vx = m17_veloc(m17_eixo(2)), vy = m17_veloc(m17_eixo(3));
+	if (vx == 0.0f && vy == 0.0f) {
+		if (andando)
+			log_info("[M17] cursor em %d,%d", spr[h].x, spr[h].y);
+		andando = 0;
+		fx = fy = 0.0f;
+		return;
+	}
+	andando = 1;
+	fx += vx;
+	fy += vy;
+	int dx = (int)fx, dy = (int)fy;
+	fx -= dx;
+	fy -= dy;
+	spr[h].x += dx;
+	spr[h].y += dy;
+	if (spr[h].x > 640 - 1) spr[h].x = 640 - 1;
+	if (spr[h].y > 480 - 1) spr[h].y = 480 - 1;
+	if (spr[h].x < 0) spr[h].x = 0;
+	if (spr[h].y < 0) spr[h].y = 0;
+}
+#endif
