diff --git a/common/vid_sdl.c b/common/vid_sdl.c
index b3fb31e..3393962 100644
--- a/common/vid_sdl.c
+++ b/common/vid_sdl.c
@@ -19,6 +19,10 @@ Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
 */
 
 #include <stdlib.h>
+#ifdef M17
+#include <stdio.h>
+#include <string.h>
+#endif
 
 #include "SDL.h"
 
@@ -248,8 +252,48 @@ VID_SetMode(const qvidmode_t *mode, const byte *palette)
         vsync_available = !!(renderer_info.flags & SDL_RENDERER_PRESENTVSYNC);
     }
 
+#ifdef M17
+    /*
+     * M17 (spec 050, D-14): a tela do aparelho diz RGBX8888 (backend mali-fbdev) e o renderer opengles2 nao aceita
+     * esse formato: o SDL criava uma 2a textura (RGB888) e convertia o quadro inteiro a cada quadro, na CPU. A textura
+     * fica num formato que o renderer aceita (o da tela, se ele aceitar; senao o 1o de 32 bits sem alfa da lista) e a
+     * tabela de cores (VID_SetPalette) escreve direto nele.
+     */
+    {
+        SDL_RendererInfo info;
+        Uint32 tela = format->format, escolhido, sem_alfa = 0, qualquer = 0;
+        const char *ft = getenv("M17_FORMATO_TELA");   /* testes do PC: a tela que o aparelho diz (RGBX8888) */
+        SDL_zero(info);
+        if (ft && !strcmp(ft, "RGBX8888"))
+            tela = SDL_PIXELFORMAT_RGBX8888;
+        escolhido = tela;
+        SDL_bool aceita = SDL_FALSE;
+        Uint32 i;
+        if (SDL_GetRendererInfo(renderer, &info) == 0 && info.num_texture_formats > 0) {
+            for (i = 0; i < info.num_texture_formats; i++) {
+                Uint32 f = info.texture_formats[i];
+                if (f == tela) aceita = SDL_TRUE;
+                if (SDL_ISPIXELFORMAT_FOURCC(f) || SDL_PIXELTYPE(f) != SDL_PIXELTYPE_PACKED32) continue;
+                if (!qualquer) qualquer = f;
+                if (!sem_alfa && !SDL_ISPIXELFORMAT_ALPHA(f)) sem_alfa = f;
+            }
+            if (!aceita && (sem_alfa || qualquer)) escolhido = sem_alfa ? sem_alfa : qualquer;
+        }
+        if (escolhido != format->format) {
+            SDL_FreeFormat(sdl_format);
+            sdl_format = SDL_AllocFormat(escolhido);
+            if (!sdl_format)
+                Sys_Error("%s: Unable to allocate pixel format (%s)", __func__, SDL_GetError());
+        }
+        fprintf(stderr, "[M17] textura: %s (renderer %s; a tela diz %s)\n", SDL_GetPixelFormatName(sdl_format->format),
+                info.name ? info.name : "?", SDL_GetPixelFormatName(tela));
+    }
+    texture = SDL_CreateTexture(renderer,
+				sdl_format->format,
+#else
     texture = SDL_CreateTexture(renderer,
 				format->format,
+#endif
 				SDL_TEXTUREACCESS_STREAMING,
 				mode->width, mode->height);
     if (!texture)
@@ -293,6 +337,29 @@ VID_SetMode(const qvidmode_t *mode, const byte *palette)
 
 /* ------------------------------------------------------------------------- */
 
+#ifdef M17
+/* testes do PC (plano D-09, D-14): o ultimo quadro como o renderer o desenha (depois da tabela de cores e da
+ * textura), num BMP de 24 bits; 0 = gravou */
+int
+M17_TelaRenderizada(const char *arq)
+{
+    SDL_Surface *s;
+    int w = 0, h = 0, r = -1;
+
+    if (!renderer || !texture || SDL_GetRendererOutputSize(renderer, &w, &h) || w <= 0 || h <= 0)
+        return -1;
+    s = SDL_CreateRGBSurfaceWithFormat(0, w, h, 24, SDL_PIXELFORMAT_RGB24);
+    if (!s)
+        return -1;
+    SDL_RenderClear(renderer);
+    SDL_RenderCopy(renderer, texture, NULL, NULL);
+    if (SDL_RenderReadPixels(renderer, NULL, SDL_PIXELFORMAT_RGB24, s->pixels, s->pitch) == 0)
+        r = SDL_SaveBMP(s, arq);
+    SDL_FreeSurface(s);
+    return r;
+}
+#endif
+
 void
 VID_SetPalette(const byte *palette)
 {
