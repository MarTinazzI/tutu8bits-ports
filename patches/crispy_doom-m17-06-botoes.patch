diff --git a/src/i_joystick.c b/src/i_joystick.c
index 258395f..4abe8ee 100644
--- a/src/i_joystick.c
+++ b/src/i_joystick.c
@@ -645,6 +645,36 @@ static int ReadButtonState(int vbutton)
 
 // Get a bitmask of all currently-pressed buttons
 
+#if defined(M17)
+// M17 (spec 043, D-12): o Crispy posta o estado dos botoes a cada leitura e o menu aceitava um botao segurado de
+// novo a cada 5 tics (o "turbo"; T01). Aqui: os botoes que desceram nesta leitura (m17_novos) e os que o menu usou
+// (m17_preso), tirados do evento ate serem soltos
+static int m17_antes, m17_novos, m17_preso;
+
+int M17_JoyMenu(int botao, int aberto)
+{
+    if (botao < 0 || botao >= 32 || !(m17_novos & (1 << botao)))
+    {
+        return 0;
+    }
+    if (!aberto)
+    {
+        return 1;
+    }
+    m17_novos &= ~(1 << botao);
+    m17_preso |= 1 << botao;
+    return 1;
+}
+
+static int M17_FiltrarBotoes(int estado)
+{
+    m17_novos = estado & ~m17_antes;
+    m17_antes = estado;
+    m17_preso &= estado;
+    return estado & ~m17_preso;
+}
+#endif
+
 static int GetButtonsState(void)
 {
     int i;
@@ -818,6 +848,9 @@ void I_UpdateJoystick(void)
 
         ev.type = ev_joystick;
         ev.data1 = GetButtonsState();
+#if defined(M17)
+        ev.data1 = M17_FiltrarBotoes(ev.data1);   // spec 043 (D-12)
+#endif
         ev.data2 = GetAxisState(joystick_x_axis, joystick_x_invert,
                                 joystick_x_dead_zone);
         ev.data3 = GetAxisState(joystick_y_axis, joystick_y_invert,
diff --git a/src/i_joystick.h b/src/i_joystick.h
