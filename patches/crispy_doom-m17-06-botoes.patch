diff --git a/src/doom/g_game.c b/src/doom/g_game.c
index da414c8..3651f4c 100644
--- a/src/doom/g_game.c
+++ b/src/doom/g_game.c
@@ -466,14 +466,27 @@ void G_BuildTiccmd (ticcmd_t* cmd, int maketic)
     // [crispy] when "always run" is active,
     // pressing the "run" key will result in walking
 #if defined(M17)
-    // M17 (spec 031, T12): sempre correndo; segurar o botao de correr (L2) anda devagar. Pela config so
-    // da um ou outro (joyb_speed >= MAX_JOY_BUTTONS liga o "sempre correr" e desliga o botao)
-    speed = true;
+    // M17 (spec 043, D-02): o botao de correr (joyb_speed, o L3) liga e desliga o andar devagar, em vez de
+    // segurar (specs 031/033/038); comeca correndo. Mensagem do "always run" do Crispy
+    {
+        static boolean m17_devagar, m17_antes;
+        const boolean m17_agora = joybspeed < MAX_JOY_BUTTONS && joybuttons[joybspeed];
+
+        if (m17_agora && !m17_antes)
+        {
+            m17_devagar = !m17_devagar;
+            M_snprintf(playermessage, sizeof(playermessage), "ALWAYS RUN %s", m17_devagar ? "OFF" : "ON");
+            player->message = playermessage;
+        }
+        m17_antes = m17_agora;
+        speed = !m17_devagar;
+        speed ^= key_speed < NUMKEYS && gamekeydown[key_speed];
+    }
 #else
     speed = (key_speed >= NUMKEYS
          || joybspeed >= MAX_JOY_BUTTONS);
-#endif
     speed ^= speedkeydown();
+#endif
  
     forward = side = look = 0;
     
