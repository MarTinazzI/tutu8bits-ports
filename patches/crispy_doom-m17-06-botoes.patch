+++ b/src/i_joystick.h
@@ -111,5 +111,13 @@ void I_UpdateJoystick(void);
 
 void I_BindJoystickVariables(void);
 
+#if defined(M17)
+// M17 (spec 043, D-12): o menu so aceita o aperto novo de um botao, e o botao que ele usou fica escondido do jogo
+// ate ser solto (sem isso o A que escolhe no dialogo do Strife chegava ao jogo como "usar" e reabria a conversa).
+// aberto = o menu (ou uma pergunta, ou o dialogo) esta na tela: so entao o botao e consumido e preso; fechado, so
+// conta a borda e o evento segue para o jogo
+int M17_JoyMenu(int botao, int aberto);
+#endif
+
 #endif /* #ifndef __I_JOYSTICK__ */
 
