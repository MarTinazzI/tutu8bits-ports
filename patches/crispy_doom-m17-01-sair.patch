diff --git a/src/doom/m_menu.c b/src/doom/m_menu.c
index 919258a..6d929b8 100644
--- a/src/doom/m_menu.c
+++ b/src/doom/m_menu.c
@@ -2343,6 +2343,11 @@ boolean M_Responder (event_t* ev)
     // "close" button pressed on window?
     if (ev->type == ev_quit)
     {
+#if defined(M17)
+        // M17 (spec 031, D-04): o SIGTERM do m17atalhos (SELECT+START) chega como um "fechar" so; sem
+        // isto ele abriria a pergunta "deseja sair?" e o jogo nao fecharia. Sai direto (grava a config).
+        I_Quit();
+#endif
         // First click on close button = bring up quit confirm message.
         // Second click on close button = confirm quit
 
