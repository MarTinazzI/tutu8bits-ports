diff --git a/src/i_main.c b/src/i_main.c
index c5967a6..288eda9 100644
--- a/src/i_main.c
+++ b/src/i_main.c
@@ -82,7 +82,11 @@ int main(int argc, char **argv)
     M_FindResponseFile();
     M_SetExeDir();
 
+#if !defined(M17)
     SDL_SetHint(SDL_HINT_NO_SIGNAL_HANDLERS, "1");
