+// M17 (spec 023): linha "[M17] ..." no stderr. write(2) direto: no libretro o file_stream_transforms.h
+// troca fprintf/fflush pelas do VFS, e o INFO_LOG nao sai no stderr (sessao 12: nao deu para provar).
+static void m17Linha(const char *fmt, ...) {
+	char linha[200];
+	va_list ap;
+	va_start(ap, fmt);
+	int n = vsnprintf(linha, sizeof(linha) - 1, fmt, ap);
+	va_end(ap);
+	if (n < 0)
+		return;
+	if (n > (int)sizeof(linha) - 2)
+		n = (int)sizeof(linha) - 2;
+	linha[n++] = '\n';
+	(void)!write(2, linha, n);
+}
