+// M17 (spec 023): VOL- e VOL+ do M17 vem do rk29-keypad (KB §7), mas o SDL do PPSSPP nao os entrega
+// (sessao 33: nenhuma tecla de teclado chegou, so os botoes do i2c-keys como controle). Sao o ALT e o
+// MENU do produto (salvar estado = VOL- + X, pausa = VOL+, controls.ini), entao o PPSSPP le o
+// dispositivo por conta propria, como o m17atalhos, e entrega as duas teclas como se fossem do teclado.
+static int m17VolumeFd = -2;
+
+static void M17LerVolume() {
+#if defined(__linux__)
+	if (m17VolumeFd == -2) {
+		m17VolumeFd = -1;
+		for (int i = 0; i < 16 && m17VolumeFd < 0; i++) {
+			char arq[32], nome[64] = "";
+			snprintf(arq, sizeof(arq), "/dev/input/event%d", i);
+			int fd = open(arq, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+			if (fd < 0)
+				continue;
+			if (ioctl(fd, EVIOCGNAME(sizeof(nome) - 1), nome) >= 0 && strcmp(nome, "rk29-keypad") == 0) {
+				m17VolumeFd = fd;
+				fprintf(stderr, "[M17] volume: %s (rk29-keypad)\n", arq);
+			} else {
+				close(fd);
+			}
+		}
+		if (m17VolumeFd < 0)
+			fprintf(stderr, "[M17] volume: rk29-keypad nao achado\n");
+	}
+	if (m17VolumeFd < 0)
+		return;
+	struct input_event ev[16];
+	ssize_t n;
+	while ((n = read(m17VolumeFd, ev, sizeof(ev))) > 0) {
+		for (int i = 0; i < (int)(n / sizeof(ev[0])); i++) {
+			if (ev[i].type != EV_KEY || ev[i].value == 2)
+				continue;
+			InputKeyCode code;
+			if (ev[i].code == KEY_VOLUMEUP)
+				code = NKCODE_VOLUME_UP;
+			else if (ev[i].code == KEY_VOLUMEDOWN)
+				code = NKCODE_VOLUME_DOWN;
+			else
+				continue;
+			KeyInput key;
+			key.flags = ev[i].value ? KeyInputFlags::DOWN : KeyInputFlags::UP;
+			key.keyCode = code;
+			key.deviceId = DEVICE_ID_KEYBOARD;
+			NativeKey(key);
+		}
+	}
+#endif
+}
+
