+/* m17.h — ganchos do M17 no TyrQuake (spec 050). */
+#ifndef M17_H
+#define M17_H
+
+/* testes do PC (plano D-09): um passo do M17_ROTEIRO; chamado a cada quadro, antes de ler os eventos */
+void M17_Roteiro(void);
+
+#endif /* M17_H */
