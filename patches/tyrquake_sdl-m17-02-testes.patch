diff --git a/common/m17_testes.c b/common/m17_testes.c
new file mode 100644
index 0000000..6ac96aa
--- /dev/null
+++ b/common/m17_testes.c
@@ -0,0 +1,227 @@
+/*
+ * m17_testes.c — ganchos dos testes do PC (spec 050, plano D-09). Sem as variaveis, nada muda.
+ *
+ * M17_ROTEIRO=<arq>: um passo a cada ~150 ms, como eventos do SDL (aperta e solta):
+ *   letras e algarismos = teclas; {ESC} {ENTER} {UP} {DOWN} {LEFT} {RIGHT} {SPACE} {TAB} = teclas;
+ *   {A} {B} {X} {Y} {L1} {R1} {L3} {R3} {START} {SELECT} {DUP} {DDOWN} {DLEFT} {DRIGHT} = botoes do game controller;
+ *   {L2} {R2} = gatilhos (eixo no maximo e de volta a 0);
+ *   {EIXO n v} = eixo n do game controller fica em v (-32768..32767) ate o proximo {EIXO n ...};
+ *   {CMD texto} = comando do console do Quake; {TELA nome} = grava M17_TELA/<nome>.bmp (o ultimo quadro, 8 bits);
+ *   | = pausa de 1 s. Comeca 1 s depois de o mapa ficar ativo (o teste espera por condicao, nao por tempo:
+ *   "[M17] roteiro: mapa ativo"); no fim, "[M17] roteiro: fim".
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "SDL.h"
+
+#include "client.h"
+#include "cmd.h"
+#include "host.h"
+#include "quakedef.h"
+#include "vid.h"
+
+#include "m17.h"
+
+static char *rot;
+static size_t rot_i, rot_n;
+static Uint32 rot_prox;
+static int rot_estado = -1;   /* -1 = nao lido; 0 = sem roteiro ou no fim; 1 = esperando o mapa; 2 = rodando */
+
+static void
+m17_log(const char *fmt, const char *arg)
+{
+    fprintf(stderr, "[M17] ");
+    fprintf(stderr, fmt, arg);
+    fprintf(stderr, "\n");
+    fflush(stderr);
+}
+
+static void
+tecla(SDL_Keycode k)
+{
+    SDL_Event e;
+    int i;
+
+    for (i = 0; i < 2; i++) {
+        memset(&e, 0, sizeof(e));
+        e.type = i == 0 ? SDL_KEYDOWN : SDL_KEYUP;
+        e.key.state = i == 0 ? SDL_PRESSED : SDL_RELEASED;
+        e.key.keysym.sym = k;
+        e.key.keysym.scancode = SDL_GetScancodeFromKey(k);
+        SDL_PushEvent(&e);
+    }
+}
+
+static void
+botao(SDL_GameControllerButton b)
+{
+    SDL_Event e;
+    int i;
+
+    for (i = 0; i < 2; i++) {
+        memset(&e, 0, sizeof(e));
+        e.type = i == 0 ? SDL_CONTROLLERBUTTONDOWN : SDL_CONTROLLERBUTTONUP;
+        e.cbutton.button = b;
+        e.cbutton.state = i == 0 ? SDL_PRESSED : SDL_RELEASED;
+        SDL_PushEvent(&e);
+    }
+}
+
+static void
+eixo(int n, int v)
+{
+    SDL_Event e;
+
+    memset(&e, 0, sizeof(e));
+    e.type = SDL_CONTROLLERAXISMOTION;
+    e.caxis.axis = n;
+    e.caxis.value = v;
+    SDL_PushEvent(&e);
+}
+
+static void
+tela(const char *nome)
+{
+    const char *dir = getenv("M17_TELA");
+    char arq[1024];
+    SDL_Surface *s;
+    SDL_Color cores[256];
+    int y, i;
+
+    if (!dir || !*dir || !vid.buffer)
+        return;
+    snprintf(arq, sizeof(arq), "%s/%s.bmp", dir, nome);
+    s = SDL_CreateRGBSurfaceWithFormat(0, vid.width, vid.height, 8, SDL_PIXELFORMAT_INDEX8);
+    if (!s)
+        return;
+    for (i = 0; i < 256; i++) {
+        cores[i].r = host_basepal[i * 3];
+        cores[i].g = host_basepal[i * 3 + 1];
+        cores[i].b = host_basepal[i * 3 + 2];
+        cores[i].a = 255;
+    }
+    SDL_SetPaletteColors(s->format->palette, cores, 0, 256);
+    for (y = 0; y < (int)vid.height; y++)
+        memcpy((byte *)s->pixels + y * s->pitch, vid.buffer + y * vid.rowbytes, vid.width);
+    if (SDL_SaveBMP(s, arq) == 0)
+        m17_log("tela: %s", arq);
+    SDL_FreeSurface(s);
+}
+
+static const struct {
+    const char *nome;
+    SDL_Keycode tecla;
+    int botao;   /* -1 = tecla */
+} fichas[] = {
+    { "ESC", SDLK_ESCAPE, -1 }, { "ENTER", SDLK_RETURN, -1 }, { "UP", SDLK_UP, -1 }, { "DOWN", SDLK_DOWN, -1 },
+    { "LEFT", SDLK_LEFT, -1 }, { "RIGHT", SDLK_RIGHT, -1 }, { "SPACE", SDLK_SPACE, -1 }, { "TAB", SDLK_TAB, -1 },
+    { "A", 0, SDL_CONTROLLER_BUTTON_A }, { "B", 0, SDL_CONTROLLER_BUTTON_B }, { "X", 0, SDL_CONTROLLER_BUTTON_X },
+    { "Y", 0, SDL_CONTROLLER_BUTTON_Y }, { "L1", 0, SDL_CONTROLLER_BUTTON_LEFTSHOULDER },
+    { "R1", 0, SDL_CONTROLLER_BUTTON_RIGHTSHOULDER }, { "L3", 0, SDL_CONTROLLER_BUTTON_LEFTSTICK },
+    { "R3", 0, SDL_CONTROLLER_BUTTON_RIGHTSTICK }, { "START", 0, SDL_CONTROLLER_BUTTON_START },
+    { "SELECT", 0, SDL_CONTROLLER_BUTTON_BACK }, { "DUP", 0, SDL_CONTROLLER_BUTTON_DPAD_UP },
+    { "DDOWN", 0, SDL_CONTROLLER_BUTTON_DPAD_DOWN }, { "DLEFT", 0, SDL_CONTROLLER_BUTTON_DPAD_LEFT },
+    { "DRIGHT", 0, SDL_CONTROLLER_BUTTON_DPAD_RIGHT },
+};
+
+/* um passo: devolve a pausa ate o proximo, em ms */
+static Uint32
+passo(void)
+{
+    char c = rot[rot_i++];
+    char ficha[256];
+    size_t i, n;
+
+    if (c == '|')
+        return 1000;
+    if (c == '\n' || c == '\r')
+        return 0;
+    if (c != '{') {
+        if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == ' ')
+            tecla((SDL_Keycode)c);
+        else if (c >= 'A' && c <= 'Z')
+            tecla((SDL_Keycode)(c - 'A' + 'a'));
+        return 150;
+    }
+    for (n = 0; rot_i < rot_n && rot[rot_i] != '}' && n < sizeof(ficha) - 1; rot_i++)
+        ficha[n++] = rot[rot_i];
+    ficha[n] = 0;
+    if (rot_i < rot_n)
+        rot_i++;   /* o '}' */
+    if (!strncmp(ficha, "CMD ", 4)) {
+        Cbuf_AddText("%s\n", ficha + 4);
+        m17_log("roteiro: cmd %s", ficha + 4);
+        return 150;
+    }
+    if (!strncmp(ficha, "TELA ", 5)) {
+        tela(ficha + 5);
+        return 150;
+    }
+    if (!strncmp(ficha, "EIXO ", 5)) {
+        int en = 0, ev = 0;
+        if (sscanf(ficha + 5, "%d %d", &en, &ev) == 2)
+            eixo(en, ev);
+        return 150;
+    }
+    if (!strcmp(ficha, "L2") || !strcmp(ficha, "R2")) {
+        int a = ficha[0] == 'L' ? SDL_CONTROLLER_AXIS_TRIGGERLEFT : SDL_CONTROLLER_AXIS_TRIGGERRIGHT;
+        eixo(a, 32767);
+        eixo(a, 0);
+        return 150;
+    }
+    for (i = 0; i < sizeof(fichas) / sizeof(fichas[0]); i++) {
+        if (strcmp(ficha, fichas[i].nome))
+            continue;
+        if (fichas[i].botao < 0)
+            tecla(fichas[i].tecla);
+        else
+            botao((SDL_GameControllerButton)fichas[i].botao);
+        return 150;
+    }
+    m17_log("roteiro: ficha desconhecida {%s}", ficha);
+    return 150;
+}
+
+void
+M17_Roteiro(void)
+{
+    Uint32 agora;
+
+    if (rot_estado < 0) {
+        const char *arq = getenv("M17_ROTEIRO");
+        FILE *f;
+        long t;
+
+        rot_estado = 0;
+        if (!arq || !*arq || !(f = fopen(arq, "rb")))
+            return;
+        fseek(f, 0, SEEK_END);
+        t = ftell(f);
+        fseek(f, 0, SEEK_SET);
+        rot = malloc(t > 0 ? t : 1);
+        rot_n = (rot && t > 0) ? fread(rot, 1, t, f) : 0;
+        fclose(f);
+        rot_estado = 1;
+        m17_log("roteiro: %s", arq);
+    }
+    if (rot_estado == 1) {
+        if (cls.state != ca_active || cls.signon != SIGNONS)
+            return;
+        rot_estado = 2;
+        rot_prox = SDL_GetTicks() + 1000;
+        m17_log("roteiro: mapa ativo%s", "");
+    }
+    if (rot_estado != 2)
+        return;
+    agora = SDL_GetTicks();
+    if (!SDL_TICKS_PASSED(agora, rot_prox))
+        return;
+    if (rot_i >= rot_n) {
+        rot_estado = 0;
+        m17_log("roteiro: fim%s", "");
+        return;
+    }
+    rot_prox = agora + passo();
+}
