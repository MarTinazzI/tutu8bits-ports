diff --git a/src/hexen/g_game.c b/src/hexen/g_game.c
index 6ed6c3f..e2e59e5 100644
--- a/src/hexen/g_game.c
+++ b/src/hexen/g_game.c
@@ -326,8 +326,13 @@ void G_BuildTiccmd(ticcmd_t *cmd, int maketic)
 
     // Allow joybspeed hack.
 
+#if defined(M17)
+    // M17 (spec 038, D-03; como no Heretic): sempre correndo; segurar o botao de correr (L2) anda devagar
+    speed = true;
+#else
     speed = (key_speed >= NUMKEYS
         || joybspeed >= MAX_JOY_BUTTONS);
+#endif
     speed ^= speedkeydown();
 
