+#include "teclado.h"
+SDL_Renderer *I_M17Renderer(void);
+
+static void M17_NomeSave(int option)
+{
+    char b[SLOTTEXTLEN + 1];
+    event_t ev = { 0 };
+    M_StringCopy(b, SlotText[option], sizeof(b));
+    if (slotptr >= 0 && slotptr <= SLOTTEXTLEN)
+        b[slotptr] = '\0';   // sem o cursor
+    ev.type = ev_keydown;
+    ev.data1 = KEY_ESCAPE;
+    if (m17_teclado(I_M17Renderer(), "Nome do save", b, SLOTTEXTLEN))
+    {
+        // so o que a digitacao de antes aceitava: letras (maiusculas), algarismos, espaco , . - !
+        for (char *c = b; *c; c++)
+        {
+            *c = toupper(*c);
+            if (!isalnum((unsigned char)*c) && !strchr(" ,.-!", *c))
+                *c = ' ';
+        }
+        M_StringCopy(SlotText[option], b, sizeof(SlotText[option]));
+        slotptr = strlen(SlotText[option]);
+        SlotText[option][slotptr] = ASCII_CURSOR;
+        SlotText[option][slotptr + 1] = '\0';
+        ev.data1 = KEY_ENTER;
+    }
+    D_PostEvent(&ev);
+}
+#endif
