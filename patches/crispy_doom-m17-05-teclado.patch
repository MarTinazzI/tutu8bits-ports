+#ifdef M17
+// M17 (spec 042, D-13): o nome do save pelo teclado virtual da spec 036, ja com o nome que o jogo propoe. OK e
+// cancelar seguem pelos caminhos do Enter e do Esc de sempre (evento posto na fila, tratado no M_Responder).
+#include "teclado.h"
+SDL_Renderer *I_M17Renderer(void);
+
+static void M17_NomeSave(char *texto, int max, const char *titulo)
+{
+    char b[SAVESTRINGSIZE];
+    event_t ev = { 0 };
+    M_StringCopy(b, texto, sizeof(b));
+    ev.type = ev_keydown;
+    ev.data1 = KEY_ESCAPE;
+    if (m17_teclado(I_M17Renderer(), titulo, b, max))
+    {
+        // a fonte do HUD so tem de '!' a '_' (maiusculas): o resto vira espaco, como na digitacao de antes
+        for (char *c = b; *c; c++)
+        {
+            *c = toupper(*c);
+            if (*c != ' ' && (*c - HU_FONTSTART < 0 || *c - HU_FONTSTART >= HU_FONTSIZE))
+                *c = ' ';
+        }
+        M_StringCopy(texto, b, max + 1);
+        ev.data1 = KEY_ENTER;
+    }
+    D_PostEvent(&ev);
+}
+#endif
