+++ b/gfx/video_driver.c
@@ -3731,6 +3731,28 @@ bool video_driver_init_internal(bool *video_is_threaded, bool verbosity_enabled)
    return true;
 }
 
+#ifdef M17
+/* M17 (spec 009, plano D-11): media de FPS do jogo (sem os quadros do menu), gravada no
+ * log ao descarregar o nucleo para o relatorio do spike. "desenhados" conta so os quadros
+ * em que o nucleo entregou imagem: com frameskip (ex.: snes9x) o nucleo repete o anterior
+ * (data NULL) e o FPS do RetroArch continua perto de 60 com o jogo travando na tela. */
+static retro_time_t m17_fps_t0, m17_fps_ult;
+static uint64_t m17_fps_quadros, m17_fps_desenhados;
+
+void m17_fps_registrar(void)
+{
+   if (m17_fps_quadros > 1 && m17_fps_ult > m17_fps_t0)
+   {
+      double seg = (double)(m17_fps_ult - m17_fps_t0) / 1000000.0;
+      RARCH_LOG("[M17] quadros=%llu desenhados=%llu segundos=%.1f fps_medio=%.2f fps_desenhado=%.2f\n",
+            (unsigned long long)m17_fps_quadros, (unsigned long long)m17_fps_desenhados, seg,
+            (double)(m17_fps_quadros - 1) / seg, (double)m17_fps_desenhados / seg);
+   }
+   m17_fps_t0 = m17_fps_ult = 0;
+   m17_fps_quadros = m17_fps_desenhados = 0;
+}
+#endif
